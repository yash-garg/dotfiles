[user]
    name = Yash-Garg
    email = me@yashgarg.dev
    signingKey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILx1G6WZ4MQ8c4hUZy2Be+GF5fZQJSssn4qnJoQ4MPxz

[core]
    autocrlf = false
    compression = 9
    # sshcommand = C:/Windows/System32/OpenSSH/ssh.exe

[init]
    defaultBranch = develop

[color]
    ui = true

[column]
    ui = auto

[alias]
    c = clone
    cp = cherry-pick
    dc = diff --cached
    fix = commit --fixup
    kang = commit --amend --reset-author
    loa = log --oneline --author='Yash Garg'
    loc = log --oneline --committer='Yash Garg'
    suicide = reset --hard
    undo = reset --soft HEAD^
    wt = worktree

[commit]
    gpgsign = true

[format]
    signoff = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = allowed_signers

[push]
    autoSetupRemote = true
    default = current

[branch]
    sort = -committerdate

[pull]
    rebase = true

[merge]
    conflictstyle = zdiff3
    log = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[diff]
    algorithm = histogram
    submodule = log
    colorMoved = default
    external = difft --display inline

[fetch]
    all = true
    fsckobjects = true
    prune = true
    pruneTags = true
    writeCommitGraph = true

[submodule]
    recurse = true

[status]
    submoduleSummary = true

[rerere]
    autoupdate = true
    enabled = true

[log]
    date = "iso"

[credential]
    helper = manager

[url "git@github.com:"]
    insteadOf = https://github.com/
    insteadOf = git://github.com/

[includeIf "gitdir/i:~/projects/work/"]
    path = ~/work.gitconfig
